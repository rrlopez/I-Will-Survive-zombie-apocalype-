[application]

config/name="I Will Survive(zombie apocalypse)"
run/main_scene="res://scene/game.tscn"
config/icon="res://icon.png"

[autoload]

Utils="*res://autoloads/utils.gd"
Constants="*res://autoloads/Constants.gd"
Globals="*res://autoloads/Globals.gd"

[input]

